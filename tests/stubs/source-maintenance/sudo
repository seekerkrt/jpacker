#!/bin/sh
set -eu

is_typed_pacman_install() {
    [ "$#" -ge 4 ] && [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-U" ] ||
        return 1
    shift 2

    if [ "${1:-}" = "--noconfirm" ]; then
        shift
    fi
    if [ "${1:-}" = "--needed" ]; then
        shift
    fi
    case ${1:-} in
        --asexplicit|--asdeps)
            shift
            ;;
    esac
    [ "$#" -ge 2 ] && [ "${1:-}" = "--" ] || return 1
    shift
    for install_artifact in "$@"; do
        [ -n "$install_artifact" ] || return 1
    done
}

install_artifacts() {
    after_separator=0
    for install_argument in "$@"; do
        if [ "$after_separator" -eq 1 ]; then
            printf '%s\n' "$install_argument"
        elif [ "$install_argument" = "--" ]; then
            after_separator=1
        fi
    done
}

require_source_maintenance_repo_install_argv() {
    [ "$#" -ge 3 ] && [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-S" ] ||
        exit 2
    shift 2
    if [ "${1:-}" = "--noconfirm" ]; then
        shift
    fi
    [ "$#" -ge 1 ] || exit 2
    for package_argument in "$@"; do
        case $package_argument in
            -*) exit 2 ;;
        esac
    done
}

require_source_maintenance_sudo_argv() {
    if [ "$#" -lt 1 ]; then
        exit 2
    fi
    case $1 in
        pacman)
            [ "$#" -ge 2 ] || exit 2
            case ${2:-} in
                -U)
                    is_typed_pacman_install "$@" || exit 2
                    ;;
                -Sc)
                    [ "$#" -eq 2 ] ||
                        { [ "$#" -eq 3 ] && [ "${3:-}" = "--noconfirm" ]; } ||
                        exit 2
                    ;;
                -Syu)
                    [ "$#" -eq 2 ] ||
                        { [ "$#" -eq 3 ] && [ "${3:-}" = "--noconfirm" ]; } ||
                        exit 2
                    ;;
                -S)
                    require_source_maintenance_repo_install_argv "$@"
                    ;;
                *)
                    exit 2
                    ;;
            esac
            ;;
        touch)
            [ "$#" -eq 2 ] || exit 2
            ;;
        tee)
            [ "$#" -eq 3 ] && [ "${2:-}" = "-a" ] || exit 2
            ;;
        install)
            [ "$#" -eq 5 ] &&
                [ "${2:-}" = "-Dm644" ] &&
                [ "${3:-}" = "--" ] &&
                [ "${4:-}" = "/dev/stdin" ] || exit 2
            ;;
        rm)
            [ "$#" -eq 3 ] && [ "${2:-}" = "-f" ] || exit 2
            ;;
        *)
            exit 2
            ;;
    esac
}

command_text=$*
printf 'sudo %s\n' "$command_text" >> "$MOGUET_TEST_COMMAND_LOG"
require_source_maintenance_sudo_argv "$@"

fail_exact_file=${MOGUET_TEST_SOURCE_MAINTENANCE_FAIL_EXACT_FILE:-}
fail_substring=${MOGUET_TEST_SOURCE_MAINTENANCE_FAIL_SUBSTRING:-}

if [ -n "$fail_exact_file" ] && [ -f "$fail_exact_file" ]; then
    if grep -Fx -- "$command_text" "$fail_exact_file" >/dev/null 2>&1 ||
       grep -Fx -- "sudo $command_text" "$fail_exact_file" >/dev/null 2>&1; then
        exit 1
    fi
fi

if [ -n "$fail_substring" ]; then
    case $command_text in
        *"$fail_substring"*) exit 1 ;;
    esac
fi

default_exit_code=${MOGUET_TEST_SUDO_EXIT_CODE:-0}
if [ "$default_exit_code" -ne 0 ]; then
    exit "$default_exit_code"
fi

if [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-Syu" ]; then
    installed_output_file=${MOGUET_TEST_PACMAN_Q_OUTPUT_FILE:-}
    post_upgrade_output_file=${MOGUET_TEST_SOURCE_MAINTENANCE_PACMAN_SYU_Q_OUTPUT_FILE:-}
    if [ -n "$post_upgrade_output_file" ]; then
        if [ -z "$installed_output_file" ] || [ ! -f "$post_upgrade_output_file" ]; then
            exit 1
        fi
        # POLICY: 成功したfake transactionだけが、case-localなinstalled stateを更新する。
        /usr/bin/cp -- "$post_upgrade_output_file" "$installed_output_file"
    fi
fi

if is_typed_pacman_install "$@"; then
    state_after_success_file=${MOGUET_TEST_MAKEPKG_PACKAGE_METADATA_STATE_AFTER_SUCCESS_FILE:-}
    metadata_state_file=${MOGUET_TEST_PACKAGE_METADATA_STATE_FILE:-}
    if [ -n "$state_after_success_file" ]; then
        if [ -z "$metadata_state_file" ] || [ ! -f "$state_after_success_file" ]; then
            exit 1
        fi
        # POLICY: source-buildのinstalled stateはfake pacman -U成功後だけ更新する。
        /usr/bin/cp -- "$state_after_success_file" "$metadata_state_file" || exit 1
    fi

    installed_artifacts=$(install_artifacts "$@") || exit 1
    installed_artifact=$(printf '%s\n' "$installed_artifacts" | /usr/bin/sed -n '1p') || exit 1
    install_success_log=${MOGUET_TEST_PACMAN_U_SUCCESS_LOG:-}
    if [ -n "$install_success_log" ]; then
        if [ ! -f "$install_success_log" ] || [ -L "$install_success_log" ] ||
           [ "${install_success_log%/*}" != "$XDG_CACHE_HOME" ]; then
            exit 1
        fi
        printf '%s\n' "$installed_artifacts" > "$install_success_log" || exit 1
    fi

    if [ "${MOGUET_TEST_REPLACE_WORKSPACE_AFTER_PACMAN_U:-0}" = "1" ]; then
        workspace_path=${installed_artifact%/*}
        workspace_parent=${workspace_path%/*}
        workspace_leaf=${workspace_path##*/}
        displaced_workspace=${workspace_path}.installed-before-cleanup
        if [ -z "$install_success_log" ] ||
           [ "$workspace_path" = "$installed_artifact" ] ||
           [ "$workspace_parent" != "$XDG_CACHE_HOME/moguet" ] ||
           [ ! -d "$workspace_path" ] || [ -L "$workspace_path" ] ||
           [ ! -f "$installed_artifact" ] || [ -L "$installed_artifact" ] ||
           [ -e "$displaced_workspace" ] || [ -L "$displaced_workspace" ]; then
            exit 1
        fi
        case $workspace_leaf in
            .artifact-workspace~-??????) ;;
            *) exit 1 ;;
        esac
        # POLICY(#242): fake installed stateを更新した後でworkspace identityを
        # 変え、CLI境界へreal cleanup partial-successを伝播させる。
        /usr/bin/mv -- "$workspace_path" "$displaced_workspace" || exit 1
        /usr/bin/mkdir -m 700 -- "$workspace_path" || exit 1
    fi
fi

if [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-Sc" ]; then
    race_path=${MOGUET_TEST_SOURCE_MAINTENANCE_PACMAN_SC_RACE_PATH:-}
    race_target=${MOGUET_TEST_SOURCE_MAINTENANCE_PACMAN_SC_RACE_TARGET:-}
    if [ -n "$race_path" ] && [ -n "$race_target" ]; then
        /usr/bin/rm -rf -- "$race_path"
        /usr/bin/ln -s -- "$race_target" "$race_path"
    fi
fi

mutate_filesystem=${MOGUET_TEST_SOURCE_MAINTENANCE_SUDO_MUTATE:-0}
if [ "$mutate_filesystem" != "1" ]; then
    exit 0
fi

case ${1:-} in
    touch)
        shift
        /usr/bin/touch "$@"
        ;;
    tee)
        shift
        /usr/bin/tee "$@"
        ;;
    install)
        shift
        destination=$4
        # stdinはshell変数へ格納せず、NULを含むbyte streamのままinstallへ渡す。
        /usr/bin/install -Dm644 -- /dev/stdin "$destination"
        ;;
    rm)
        shift
        /usr/bin/rm "$@"
        ;;
esac

exit 0
