#!/bin/sh
printf 'git %s\n' "$*" >> "$JPACKER_TEST_COMMAND_LOG"
if [ "$1" = "clone" ]; then
    if [ -n "${JPACKER_TEST_GIT_CLONE_SYMLINK_TARGET:-}" ]; then
        ln -s "$JPACKER_TEST_GIT_CLONE_SYMLINK_TARGET" "$3"
        exit "${JPACKER_TEST_GIT_CLONE_EXIT_CODE:-1}"
    fi
    mkdir -p "$3/.git"
    exit "${JPACKER_TEST_GIT_CLONE_EXIT_CODE:-0}"
fi
if [ "$1" = "config" ]; then
    if [ -n "${JPACKER_TEST_GIT_REMOTE_URL:-}" ]; then
        printf '%s\n' "$JPACKER_TEST_GIT_REMOTE_URL"
        exit 0
    fi
    printf 'https://aur.archlinux.org/%s.git\n' "$(basename "$PWD")"
    exit 0
fi
exit 0
