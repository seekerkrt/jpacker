#!/bin/sh
set -eu

is_artifact_identity_query() {
    expected_identity_format=$(printf '%s\t%s' '%n' '%v')
    [ "$#" -eq 6 ] &&
        [ "${1:-}" = "-U" ] &&
        [ "${2:-}" = "--print" ] &&
        [ "${3:-}" = "--print-format" ] &&
        [ "${4:-}" = "$expected_identity_format" ] &&
        [ "${5:-}" = "--" ] &&
        [ -n "${6:-}" ]
}

require_read_only_pacman_argument_tail() {
    while [ "$#" -gt 0 ]; do
        case $1 in
            --)
                # POLICY: pacmanの`--`以降はoptionではなくopaque operandとして扱う。
                return 0
                ;;
            --arch|--assume-installed|--cachedir|--color|--config|--dbpath|\
            --gpgdir|--hookdir|--ignore|--ignoregroup|--logfile|--overwrite|\
            --print-format|--root|--sysroot|-b|-r)
                [ "$#" -ge 2 ] || exit 2
                shift 2
                ;;
            --arch=*|--assume-installed=*|--cachedir=*|--color=*|--config=*|\
            --dbpath=*|--gpgdir=*|--hookdir=*|--ignore=*|--ignoregroup=*|\
            --logfile=*|--overwrite=*|--print-format=*|--root=*|--sysroot=*)
                shift
                ;;
            --noconfirm|--needed|--refresh|--search|--info|-s|-i|-y)
                shift
                ;;
            -*)
                exit 2
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_read_only_pacman_argv() {
    if [ "$#" -lt 1 ]; then
        exit 2
    fi
    case $1 in
        -U)
            is_artifact_identity_query "$@" || exit 2
            ;;
        -Qm)
            [ "$#" -eq 1 ] || exit 2
            ;;
        -Q|-Si|-Ss|-F|-Fl|-Gx)
            [ "$#" -ge 2 ] || exit 2
            shift
            require_read_only_pacman_argument_tail "$@"
            ;;
        -S)
            [ "$#" -ge 3 ] || exit 2
            case ${2:-} in
                --search|-s|--info|-i) ;;
                *) exit 2 ;;
            esac
            shift 2
            require_read_only_pacman_argument_tail "$@"
            ;;
        *)
            exit 2
            ;;
    esac
}

printf 'pacman %s\n' "$*" >> "$MOGUET_TEST_COMMAND_LOG"
require_read_only_pacman_argv "$@"

if is_artifact_identity_query "$@"; then
    artifact_path=$6
    identity_exit_code=${MOGUET_TEST_PACMAN_ARTIFACT_IDENTITY_EXIT_CODE:-0}
    if [ "$identity_exit_code" -ne 0 ]; then
        exit "$identity_exit_code"
    fi
    if [ -z "$artifact_path" ] || [ ! -f "$artifact_path" ]; then
        exit 1
    fi
    /usr/bin/awk 'NR == 1 { printf "%s\t%s\n", $1, $2; found = 1; exit }
        END { if (!found) exit 1 }' "$artifact_path"
    exit $?
fi
if [ "$1" = "-Qm" ] && [ -n "${MOGUET_TEST_PACMAN_QM_OUTPUT:-}" ]; then
    printf '%s\n' "$MOGUET_TEST_PACMAN_QM_OUTPUT"
fi
if [ "$1" = "-Q" ] && [ -n "${MOGUET_TEST_PACMAN_Q_OUTPUT:-}" ]; then
    printf '%s\n' "$MOGUET_TEST_PACMAN_Q_OUTPUT"
    exit "${MOGUET_TEST_PACMAN_Q_EXIT_CODE:-0}"
fi
if [ "$1" = "-Q" ] && [ -n "${MOGUET_TEST_PACMAN_Q_OUTPUT_FILE:-}" ]; then
    if [ -f "$MOGUET_TEST_PACMAN_Q_OUTPUT_FILE" ]; then
        /usr/bin/awk -v package="${2:-}" '
            $1 == package { print; found = 1; exit }
            END { if (!found) exit 1 }
        ' "$MOGUET_TEST_PACMAN_Q_OUTPUT_FILE"
        query_exit_code=$?
        if [ "$query_exit_code" -eq 0 ]; then
            exit "${MOGUET_TEST_PACMAN_Q_EXIT_CODE:-0}"
        fi
    fi
    exit 1
fi
if [ "$1" = "-Si" ] && [ -n "${MOGUET_TEST_PACMAN_REPO_PACKAGES:-}" ]; then
    for package in $MOGUET_TEST_PACMAN_REPO_PACKAGES; do
        if [ "${2:-}" = "$package" ]; then
            exit 0
        fi
    done
    exit 1
fi
exit "${MOGUET_TEST_PACMAN_EXIT_CODE:-1}"
