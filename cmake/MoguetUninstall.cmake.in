cmake_minimum_required(VERSION 3.18)

set(_moguet_install_manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(
    NOT EXISTS "${_moguet_install_manifest}"
    OR IS_DIRECTORY "${_moguet_install_manifest}"
)
    message(
        FATAL_ERROR
        "Moguet install manifest is unavailable: ${_moguet_install_manifest}"
    )
endif()

set(_moguet_destdir "$ENV{DESTDIR}")
if(NOT _moguet_destdir STREQUAL "" AND NOT IS_ABSOLUTE "${_moguet_destdir}")
    message(FATAL_ERROR "DESTDIR must be empty or absolute: ${_moguet_destdir}")
endif()

file(STRINGS "${_moguet_install_manifest}" _moguet_installed_files)
if(NOT _moguet_installed_files)
    message(FATAL_ERROR "Moguet install manifest is empty")
endif()

foreach(_moguet_installed_file IN LISTS _moguet_installed_files)
    if(NOT IS_ABSOLUTE "${_moguet_installed_file}")
        message(
            FATAL_ERROR
            "Moguet install manifest contains a non-absolute path: "
            "${_moguet_installed_file}"
        )
    endif()

    set(_moguet_staged_file "${_moguet_destdir}${_moguet_installed_file}")
    if(
        IS_DIRECTORY "${_moguet_staged_file}"
        AND NOT IS_SYMLINK "${_moguet_staged_file}"
    )
        message(
            FATAL_ERROR
            "Refusing to uninstall a directory recorded as a file: "
            "${_moguet_staged_file}"
        )
    endif()

    if(EXISTS "${_moguet_staged_file}" OR IS_SYMLINK "${_moguet_staged_file}")
        message(STATUS "Removing ${_moguet_staged_file}")
        file(REMOVE "${_moguet_staged_file}")
        if(
            EXISTS "${_moguet_staged_file}"
            OR IS_SYMLINK "${_moguet_staged_file}"
        )
            message(FATAL_ERROR "Failed to remove ${_moguet_staged_file}")
        endif()
    else()
        message(STATUS "Already absent: ${_moguet_staged_file}")
    endif()
endforeach()
